# SmartHire Environment Configuration Template
# Copy this file to .env or configure in application.properties / system environment variables

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smarthire_db
DB_USERNAME=root
DB_PASSWORD=root

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=smarthire_nosql
MONGODB_URI=mongodb://localhost:27017/smarthire_nosql

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
