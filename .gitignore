# ===================================================================
# SmartHire Platform - Root GitIgnore Configuration
# Polyglot Full-Stack: Spring Boot 3 (Java 21) + Vite + React + TS
# ===================================================================

# -------------------------------------------------------------------
# Java & JVM Runtime
# -------------------------------------------------------------------
*.class
*.log
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*
*.seed
*.pid
*.pid.lock

# Package files & Archives
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Preserve Maven Wrapper JAR
!.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.jar

# -------------------------------------------------------------------
# Maven Build Tool
# -------------------------------------------------------------------
target/
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# -------------------------------------------------------------------
# Gradle Build Tool (if opened via Gradle-enabled IDEs)
# -------------------------------------------------------------------
.gradle/
**/build/
!backend/src/**/build/

# -------------------------------------------------------------------
# Node.js, Frontend & Bundler (Vite / React / TypeScript)
# -------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Node / Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------------------------------------------
# Database, Local Persistence & Flyway Cache
# -------------------------------------------------------------------
backend/data/
**/data/
*.mv.db
*.trace.db
*.lock.db
*.sqlite
*.sqlite3

# -------------------------------------------------------------------
# File Uploads, Media & User-Generated Content
# -------------------------------------------------------------------
uploads/
**/uploads/
!uploads/.gitkeep
!backend/uploads/.gitkeep

# -------------------------------------------------------------------
# Environment Variables, Secrets & Certificates (Security Critical)
# -------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_ed25519
secrets/

# -------------------------------------------------------------------
# Code Coverage & Test Reports
# -------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
reports/
test-results/

# -------------------------------------------------------------------
# IDEs & Code Editors
# -------------------------------------------------------------------
# JetBrains / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# Eclipse
.metadata
.classpath
.project
.settings/
bin/
tmp/

# NetBeans
nbproject/private/
nbbuild/
nbdist/

# Generic Windows / Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# -------------------------------------------------------------------
# Operating Systems & Cloud Sync (Windows / macOS / Linux / OneDrive)
# -------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Windows & OneDrive
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp

# Linux
*~
.directory
